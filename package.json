{
  "name": "mistral-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:intelligence && npm run build:web",
    "build:intelligence": "npm run build -w @mistral-city/intelligence",
    "build:web": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "preview": "vite preview",
    "city-intel": "npm run build:intelligence --silent && node packages/intelligence/dist/cli.js",
    "benchmark:health": "npm run benchmark:health -w @mistral-city/intelligence",
    "benchmark:health:live": "npm run benchmark:health:live -w @mistral-city/intelligence",
    "demo:mock": "npm run demo:mock -w @mistral-city/intelligence",
    "test": "npm test -w @mistral-city/intelligence",
    "typecheck": "npm run typecheck -w @mistral-city/intelligence"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
