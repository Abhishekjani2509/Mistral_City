{
  "name": "@mistral-city/intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "city-intel": "dist/cli.js" },
  "exports": {
    ".": "./dist/index.js",
    "./city-model.schema.json": "./contracts/city-model.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "city-intel": "npm run build --silent && node dist/cli.js",
    "benchmark:health": "npm run build --silent && node examples/health-benchmarks.mjs",
    "benchmark:health:live": "npm run build --silent && node examples/health-benchmarks.mjs --live",
    "demo:mock": "npm run build --silent && node examples/mock-scan.mjs",
    "test": "npm run build --silent && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "commander": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0"
  },
  "engines": { "node": ">=20.19" }
}
